{
  "name": "wornways",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "apps/cli",
    "apps/web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.tests.json && npm run build -w @wornways/web",
    "test": "TZ=UTC vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "cli": "node --conditions=source --import tsx apps/cli/src/main.ts",
    "dev:web": "npm run dev -w @wornways/web",
    "test:web": "playwright test",
    "dev:phone": "npm run phone -w @wornways/web",
    "icons": "node apps/web/scripts/make-icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
